# Discord Bot Configuration
# Copy this file to .env and replace with your actual bot token

DISCORD_BOT_TOKEN=your_bot_token_here

# Optional extras
# Free key from https://developers.giphy.com — enables the `sgif <query>` command
GIPHY_API_KEY=
# Optional personal NASA key (defaults to the shared DEMO_KEY) — used by `snasa`
NASA_API_KEY=
